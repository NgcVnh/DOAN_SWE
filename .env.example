# ==========================================
# BrewLite — Environment Variables Template
# ==========================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=brewlite_user
POSTGRES_PASSWORD=brewlite_password
POSTGRES_DB=brewlite_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://brewlite_user:brewlite_password@localhost:5432/brewlite_db?schema=public

# Backend API Configuration (NestJS)
PORT=3001
NODE_ENV=development
JWT_SECRET=brewlite_super_secret_jwt_key_2026

# Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001
