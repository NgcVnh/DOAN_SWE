{
  "name": "brewlite-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "npm --prefix apps/api run start:dev",
    "dev:frontend": "npm --prefix apps/web run dev",
    "dev:backend": "npm --prefix apps/api run start:dev",
    "build:web": "npm --prefix apps/web run build",
    "build:api": "npm --prefix apps/api run build",
    "build:frontend": "npm --prefix apps/web run build",
    "build:backend": "npm --prefix apps/api run build",
    "db:push": "npm --prefix apps/api run db:push",
    "db:seed": "npm --prefix apps/api run db:seed",
    "prisma:generate": "npm --prefix apps/api run prisma:generate",
    "prisma:studio": "npm --prefix apps/api npx prisma studio"
  }
}
